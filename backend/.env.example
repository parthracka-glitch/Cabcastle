# ==========================================
# DriveHub Goa — Backend Environment Variables
# ==========================================

# Server Configuration
PORT=8000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local URI)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Cluster0
DB_NAME=drivehub_goa

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long
ADMIN_EMAIL=admin@drivehubgoa.com
ADMIN_PASSWORD=YourSecureAdminPassword123!

# Cloudinary Storage Configuration (Vehicle & Document Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Google OAuth 2.0 Credentials (Customer Social Login)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
