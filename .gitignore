# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Environment files & Secrets (STRICT - NEVER COMMIT)
.env
.env.*
!.env.example
!.env.production
*.env
!*.env.example
!*.env.production
env*
!env*.example
!env*.production
env (*)
*.pem
*.key
*.cert
credentials.json
.credentials
*token.json*
*credentials.json*

# Production Builds & Output
dist/
dist
build/
build
/out/
.next/
*.tsbuildinfo

# Logs and Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
dump.rdb

# Operating System & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Test & Coverage Artifacts
/coverage
.nyc_output
test_reports/
test_result.md
*.xml

# Build Caches
.cache/
.eslintcache
.parcel-cache

# Python (Legacy)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
.pytest_cache/

# Archives & Large Zips
*.zip
*.tar.gz
